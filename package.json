{
  "name": "antigravity-plugin-agent-team",
  "displayName": "Agent Team: A plugin for Google Antigravity App",
  "version": "1.0.3",
  "description": "Project-agnostic, multi-disciplinary autonomous full-stack agent team plugin for Antigravity. End to end task execution, error-free.",
  "license": "MIT",
  "author": "Phillip Webber <github@webbsense.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Domush/antigravity-plugin-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/Domush/antigravity-plugin-agent-team/issues"
  },
  "homepage": "https://github.com/Domush/antigravity-plugin-agent-team#readme",
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "agent-team",
    "multi-agent",
    "orchestration",
    "software-engineering",
    "3d-modeling",
    "adversarial-audit",
    "quality-assurance"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node scripts/audit-gate.js -f \"rules/AGENTS.md,rules/coding-standards.md,rules/agent-governance-standards.md,scripts/audit-gate.js,bin/cli.js\"",
    "gate": "node scripts/audit-gate.js",
    "install:global": "node bin/cli.js install --global",
    "install:workspace": "node bin/cli.js install --workspace",
    "status": "node bin/cli.js status"
  },
  "bin": {
    "antigravity-agent-team": "bin/cli.js",
    "agent-team": "bin/cli.js"
  },
  "main": "bin/cli.js",
  "files": [
    "bin",
    "scripts",
    "agents",
    "rules",
    "skills",
    "assets",
    "plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}